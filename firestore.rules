rules_version = '2';

// The web app NEVER accesses Firestore directly from the browser — all menu
// reads and writes go through the Next.js server using the Firebase Admin SDK,
// which bypasses these rules entirely. Therefore client access must be fully
// denied. This closes the "Test mode" default that would otherwise let anyone
// read or write the database.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
